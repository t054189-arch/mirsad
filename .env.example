# Supabase — project settings → API
# Both are safe to expose to the browser; row level security is what protects
# your data, so enable RLS on every table you create.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Server-side only. Bypasses row level security — never expose it to the
# browser and never prefix it with NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
